{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "hidden": true,
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "spaces"
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "strip-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "divider": {
            "width": 1,
            "color": "border"
          },
          "children": [
            {
              "id": "work-main",
              "type": "column",
              "size": {
                "weight": 56
              },
              "min": 360,
              "resizable": false,
              "children": [
                {
                  "id": "main-wrap",
                  "type": "row",
                  "padding": 8,
                  "children": [
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "header": {
                            "content": {
                              "mod": "pane"
                            },
                            "reveal": "always",
                            "height": 30,
                            "position": "top"
                          },
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "radius": 10,
                          "gap": 8,
                          "lone": true
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "stage",
              "type": "block",
              "content": {
                "mod": "stage"
              },
              "size": {
                "weight": 44
              },
              "min": 320,
              "max": 1400
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "reviews",
                      "type": "block",
                      "content": {
                        "mod": "reviews"
                      }
                    },
                    {
                      "id": "projects",
                      "type": "block",
                      "content": {
                        "mod": "projects"
                      }
                    }
                  ],
                  "active": "files",
                  "size": {
                    "weight": 1
                  }
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "gap": 8
            }
          ]
        },
        {
          "id": "strip",
          "type": "block",
          "content": {
            "mod": "board-strip"
          },
          "size": {
            "px": 166
          },
          "min": 166
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "min": 28,
          "max": 28
        }
      ]
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
